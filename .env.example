# Agent Ouija — environment variables
# Copy this file to .env on the rig that runs the arena (Brainy).
# .env is gitignored — never commit real keys.
#
# Required only when the matching cloud model is enabled in ARENA_MODELS.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Serper.dev (Google Search API). Used by the Research tab to fetch web
# results and inject them as context into every selected model's call —
# lets locals + clouds both answer with web-grounded facts.
SERPER_API_KEY=

# NewsAPI (https://newsapi.org) — daily news pulls into RAG.
# Free tier: 100 requests/day. Sports (baseball-centric) + world +
# national manual pulls each cost 1 request. See config.py for tuning.
NEWSAPI_KEY=

# ── Email delivery (📧 Send buttons on Files + Agent Ouija tabs) ─────────────
# Powers the "📧 Email Last Edit" button that ships the most-recent
# image-edit output as an attachment. Standard SMTP — any provider
# that supports plain SMTP + STARTTLS on port 587 works (Gmail,
# Outlook, Fastmail, Proton bridge, etc.). Skip these keys if you
# don't want the email feature; the button will surface a friendly
# "SMTP not configured" message instead of crashing.
#
# Gmail example (needs a Google account App Password, NOT your
# normal login password — https://myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASSWORD=<16-char app password with no spaces>
#   EMAIL_FROM=your.address@gmail.com
#   EMAIL_TO=your.address@gmail.com     # can be same as FROM
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
